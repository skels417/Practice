<Window x:Class="FortuneTellerApp.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление пользователями" Height="400" Width="300">
    <Grid>
        <TextBlock Text="Управление пользователями" FontSize="16" Margin="10"/>
        <ListBox Name="UserList" Margin="10,40,10,10"/>
        <Button Name="AddUserButton" Content="Добавить пользователя" Click="AddUserButton_Click" Width="150" Height="30" Margin="10,220,10,10"/>
        <Button Name="EditUserButton" Content="Редактировать пользователя" Click="EditUserButton_Click" Width="150" Height="30" Margin="10,260,10,10"/>
        <Button Name="DeleteUserButton" Content="Удалить пользователя" Click="DeleteUserButton_Click" Width="150" Height="30" Margin="10,300,10,10"/>
    </Grid>
</Window>