<Window x:Class="FortuneTellerApp.PredictionManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление предсказаниями" Height="400" Width="300">
    <Grid>
        <TextBlock Text="Управление предсказаниями" FontSize="16" Margin="10"/>
        <ListBox Name="PredictionList" Margin="10,40,10,10"/>
        <Button Name="AddPredictionButton" Content="Добавить предсказание" Click="AddPredictionButton_Click" Width="150" Height="30" Margin="10,220,10,10"/>
        <Button Name="EditPredictionButton" Content="Редактировать предсказание" Click="EditPredictionButton_Click" Width="150" Height="30" Margin="10,260,10,10"/>
        <Button Name="DeletePredictionButton" Content="Удалить предсказание" Click="DeletePredictionButton_Click" Width="150" Height="30" Margin="10,300,10,10"/>
        <Button Content="Лайк" Click="LikePredictionButton_Click" Width="150" Height="30" Margin="10,10,10,15"/>
        <Button Content="Дизлайк" Click="DislikePredictionButton_Click" Width="150" Height="30" Margin="10,55,10,10"/>
    </Grid>
</Window>